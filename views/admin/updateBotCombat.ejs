<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <%- include('../partials/headfile'); %>
    <title>Bot Combat Manager | AETHERBORNE</title>
    <style>
        .bot-table {
            background: var(--card-bg);
            border-radius: 0.5rem;
            overflow: hidden;
        }
        .bot-table thead {
            background: var(--primary-color);
            color: white;
        }
        .bot-table th {
            border: none;
            padding: 1rem;
        }
        .bot-table td {
            vertical-align: middle;
            padding: 0.75rem 1rem;
            border-color: var(--border-color);
        }
        .status-badge {
            padding: 0.35em 0.65em;
            font-size: 0.75em;
            font-weight: 600;
            border-radius: 0.25rem;
        }
        .status-eligible {
            background-color: rgba(25, 135, 84, 0.2);
            color: #198754;
        }
        .status-banned {
            background-color: rgba(220, 53, 69, 0.2);
            color: #dc3545;
        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">
    <%- include('../partials/navbar'); %>

    <div class="container py-4 flex-grow-1">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Bot Combat Manager</h1>
        </div>
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-search me-2"></i>Search Bot in Hiscores</h5>
            </div>
            <div class="card-body">
                <form id="updateBotForm" method="POST" action="/admin/update-bot-combat-alias">
                    <div class="row g-3">
                        <div class="col-md-10">
                            <input type="text" id="botSearch" class="form-control" placeholder="Enter bot name..." aria-label="Bot name">
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" type="button" id="searchBotBtn">
                                <i class="bi bi-search me-1"></i> Search
                            </button>
                        </div>
                    </div>
                    <div id="searchResult" class="mt-3"></div>
                    <input type="hidden" id="hiddenSearchedName" name="searchedNameToAlias">
                    <input type="hidden" id="hiddenNewCombatLevel" name="newCombatLevel">
                </form>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Bot List</h2>
            <div class="btn-group" role="group" aria-label="Bot list filter">
                <button type="button" class="btn btn-outline-primary active" data-source="eligible">Eligible</button>
                <button type="button" class="btn btn-outline-secondary" data-source="banned">Banned</button>
            </div>
        </div>
        <input type="hidden" id="botSource" value="eligible">
        <div id="botListLoading" class="text-center my-5 py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading bot list...</p>
        </div>
        <div class="table-responsive">
            <table class="table table-hover bot-table">
                <thead class="table-dark">
                    <tr>
                        <th>Bot Name</th>
                        <th>Alias</th>
                        <th>Status</th>
                        <th>Combat Level</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="botTableBody" class="table-group-divider">
                    <!-- Will be populated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Update Alias Modal -->
    <div class="modal fade" id="aliasModal" tabindex="-1" aria-labelledby="aliasModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="aliasModalLabel">Update Combat Alias</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="updateAliasForm">
                        <input type="hidden" id="botId" name="id">
                        <div class="mb-3">
                            <label for="alias" class="form-label">Alias</label>
                            <input type="text" class="form-control" id="alias" name="alias" required>
                        </div>
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-download me-1"></i> Fetch Combat Level
                            </button>
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                    <hr>
                    <form id="banBotForm" method="POST" action="/adminRoute/banned" class="mt-3">
                        <input type="hidden" id="banBotId" name="id">
                        <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Are you sure you want to ban this bot?')">
                            <i class="bi bi-slash-circle me-1"></i> Ban Bot
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts partial is included at the end of body -->
    
    <script>
        // Cache configuration
        const CACHE_PREFIX = 'bot_list_cache_';
        const CACHE_EXPIRY = 60 * 60 * 1000; // 1 hour in milliseconds
        
        // Map of source types to their API endpoints
        const BOT_SOURCES = {
            'eligible': '/adminRoute/api/eligible-bots',
            'all': '/qcRoute/botList',
            'recent': '/qcRoute/latest-bots',
            'player': '/qcRoute/player-latest-bots'
        };
        
        // Get cached data if it exists and isn't expired
        function getCachedData(key) {
            const cacheKey = CACHE_PREFIX + key;
            const cached = localStorage.getItem(cacheKey);
            const timestamp = localStorage.getItem(cacheKey + '_time');
            
            if (cached && timestamp) {
                const age = Date.now() - parseInt(timestamp, 10);
                if (age < CACHE_EXPIRY) {
                    return JSON.parse(cached);
                }
                // Clear expired cache
                localStorage.removeItem(cacheKey);
                localStorage.removeItem(cacheKey + '_time');
            }
            return null;
        }
        
        // Save data to cache with timestamp
        function saveToCache(key, data) {
            const cacheKey = CACHE_PREFIX + key;
            localStorage.setItem(cacheKey, JSON.stringify(data));
            localStorage.setItem(cacheKey + '_time', Date.now().toString());
        }
        
        // Fetch bot list from server
        async function fetchBotList(source) {
            const endpoint = BOT_SOURCES[source];
            if (!endpoint) {
                console.error('No endpoint defined for source:', source);
                return [];
            }
            
            try {
                console.log('Fetching bots from:', endpoint);
                const response = await fetch(endpoint, {
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    credentials: 'same-origin' // Include cookies for authentication
                });
                
                // First check if the response is JSON
                const contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    const text = await response.text();
                    console.error('Expected JSON but got:', text.substring(0, 200)); // Log first 200 chars of non-JSON response
                    throw new Error(`Expected JSON response but got ${contentType}`);
                }
                
                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({}));
                    throw new Error(errorData.message || `HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                console.log('Received bot data:', data);
                
                // Ensure we have an array of bots
                return Array.isArray(data) ? data : [];
            } catch (error) {
                console.error('Error in fetchBotList:', {
                    source,
                    endpoint,
                    error: error.message,
                    stack: error.stack
                });
                throw error;
            }
        }
        
        // Populate the bot select dropdown and table
        function populateBotSelect(bots) {
            const $select = $('#botSelect');
            $select.empty().append('<option value="">-- Select a bot --</option>');
            
            if (!bots || bots.length === 0) {
                $select.append('<option value="" disabled>No bots found</option>');
                populateBotTable([]);
                return;
            }
            
            bots.forEach(bot => {
                // Handle different response formats from different endpoints
                const botId = bot._id || bot.id || '';
                const botName = bot.bot_name || bot.name || 'Unknown Bot';
                const combatLevel = bot.combat_lv || bot.combatLevel || 'N/A';
                
                $select.append(`<option value="${botId}" data-combat-lv="${combatLevel}">
                    ${botName} (Combat: ${combatLevel}${bot.status ? ', ' + bot.status : ''})
                </option>`);
            });
            
            $select.prop('disabled', false);
            
            // Also populate the table
            populateBotTable(bots);
        }
        
        // Populate the bot table
        function populateBotTable(bots) {
            const $tableBody = $('#botTableBody');
            $tableBody.empty();
            
            if (!bots || bots.length === 0) {
                $tableBody.append('<tr><td colspan="5" class="text-center">No bots found</td></tr>');
                return;
            }
            
            bots.forEach(bot => {
                const botId = bot._id || bot.id || '';
                const botName = bot.bot_name || bot.name || 'Unknown Bot';
                const aliases = Array.isArray(bot.alias) ? bot.alias.join(', ') : (bot.alias || '');
                const status = bot.status || 'UNKNOWN';
                const combatLevel = bot.combat_lv || bot.combatLevel || 0;
                
                const statusBadge = status === 'ACTIVE' ? 'badge-success' : 'badge-danger';
                
                const $row = $(`
                    <tr data-bot-id="${botId}">
                        <td><a href="/deRoute/botKills?id=${botId}" class="text-white">${botName}</a></td>
                        <td>${aliases}</td>
                        <td><span class="badge ${statusBadge}">${status}</span></td>
                        <td>${combatLevel}</td>
                        <td>
                            <button type="button" class="btn btn-primary btn-sm update-alias-btn" data-bs-toggle="modal" data-bs-target="#aliasModal" data-id="${botId}" data-alias="${aliases}">
                                Update Alias
                            </button>
                        </td>
                    </tr>
                `);
                
                $tableBody.append($row);
            });
            
            // Re-bind modal handlers for the new buttons
            $('.update-alias-btn').off('click').on('click', function() {
                const $button = $(this);
                const botId = $button.data('id');
                // Get the bot name from the first cell in the same row
                const botName = $button.closest('tr').find('td:first').text().trim();
                
                // Set the values in the modal
                $('#aliasModal').data('bot-id', botId);
                $('#botId').val(botId);
                $('#banBotId').val(botId);
                // Set the alias field value to the bot's name
                setTimeout(() => {
                    $('#alias').val(botName);
                }, 0);
            });
        }
        
        // Load bots for the selected source
        async function loadBots(source) {
            const $loading = $('#botListLoading');
            const $select = $('#botSelect');
            
            // Reset UI
            $select.prop('disabled', true).empty().append('<option value="">Loading...</option>');
            $loading.show();
            
            try {
                // Try to get from cache first
                let bots = getCachedData(source);
                
                if (!bots) {
                    // Not in cache or expired, fetch from server
                    bots = await fetchBotList(source);
                    saveToCache(source, bots);
                }
                
                populateBotSelect(bots);
                
            } catch (error) {
                console.error('Error loading bots:', error);
                $select.empty().append('<option value="" disabled>Error loading bot list</option>');
                
                // Show error to user
                const $alert = $(`
                    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                        Failed to load bot list. ${error.message || 'Please try again.'}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                `);
                
                $select.after($alert);
                
                // Auto-dismiss after 5 seconds
                setTimeout(() => $alert.alert('close'), 5000);
                
            } finally {
                $loading.hide();
            }
        }
        
        // Initialize the page
        $(document).ready(function() {
            // Initialize bot source selector
            const $botSource = $('#botSource');
            
            // Automatically load eligible bots
            loadBots('eligible');
            
            // Clear cache button (for debugging)
            $('#clearCacheBtn').on('click', function() {
                Object.keys(BOT_SOURCES).forEach(source => {
                    localStorage.removeItem(CACHE_PREFIX + source);
                    localStorage.removeItem(CACHE_PREFIX + source + '_time');
                });
                alert('Cache cleared!');
                // Reload the current source
                loadBots($botSource.val());
            });
            
            // Initialize the bot source dropdown if there's a stored preference
            const savedSource = localStorage.getItem('selectedBotSource');
            if (savedSource && BOT_SOURCES[savedSource]) {
                $botSource.val(savedSource);
            }
            
            // Save the selected source when it changes
            $botSource.on('change', function() {
                localStorage.setItem('selectedBotSource', $(this).val());
            });
        });
        
        // Add cache clear button (for debugging)
        $('body').append('<button id="clearCacheBtn" class="btn btn-sm btn-secondary position-fixed" style="bottom: 20px; right: 20px;">Clear Cache</button>');
    </script>
    
    <script>
        // JavaScript to handle modal population
        $('#aliasModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); // Button that triggered the modal
            var id = button.data('id'); // Extract info from data-* attributes
            var alias = button.data('alias');
    
            var modal = $(this);
            modal.find('#botId').val(id);
            modal.find('#banBotId').val(id); // Set bot ID for ban form
            modal.find('#alias').val(alias);
        });
    
        // Handle form submission for combat level update
        $('#updateAliasForm').on('submit', function(event) {
            event.preventDefault(); // Prevent default form submission
            const form = $(this);
            const alias = form.find('#alias').val().trim();
            const botId = form.find('#botId').val();
            
            if (!alias) {
                alert('Please enter an alias');
                return;
            }
            
            // Show loading state
            const $submitBtn = form.find('button[type="submit"]');
            const originalBtnText = $submitBtn.html();
            $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Updating...');
            
            // Make the API call
            $.ajax({
                url: '/adminRoute/update-alias-and-fetch-combat',
                method: 'POST',
                data: { 
                    botId: botId, 
                    alias: alias 
                },
                success: function(response) {
                    if (response.success) {
                        // Update the table row with the new data
                        const $row = $('tr[data-bot-id="' + botId + '"]');
                        $row.find('td:nth-child(2)').text(alias); // Update alias column
                        $row.find('td:nth-child(4)').text(response.combatLevel || response.combat_lv || 'N/A'); // Update combat level column
                        
                        // Close the modal
                        const modal = bootstrap.Modal.getInstance(document.getElementById('aliasModal'));
                        if (modal) {
                            modal.hide();
                        }
                        
                        // Show success message
                        alert('Bot updated successfully!');
                    } else {
                        alert(response.message || 'Failed to update bot');
                    }
                },
                error: function(xhr) {
                    let errorMessage = 'An error occurred while updating the bot';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    alert('Error: ' + errorMessage);
                },
                complete: function() {
                    // Restore button state
                    $submitBtn.prop('disabled', false).html(originalBtnText);
                }
            });
        });
    
        // Handle form submission for BANNED action
        $('#banBotForm').on('submit', function(event) {
            event.preventDefault();
            const form = $(this);
            const botId = form.find('#banBotId').val();
            
            $.post(form.attr('action'), { id: botId })
                .done(function(data) {
                    alert('Bot has been banned successfully!');
                    // Remove the row from the table
                    $('tr[data-bot-id="' + botId + '"]').remove();
                    $('#aliasModal').modal('hide');
                    $('.modal-backdrop').remove();
                })
                .fail(function(xhr) {
                    const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : 'Unknown error occurred';
                    alert('Error: ' + errorMessage);
                });
        });

    </script>
    <script>
        // Enable/disable update button based on form validity
        function updateSubmitButton() {
            const isValid = $('#botSelect').val() && $('#hiddenSearchedName').val() && $('#hiddenNewCombatLevel').val();
            $('#updateBotBtn').prop('disabled', !isValid);
        }

        // Handle bot search
        $('#searchBotBtn').on('click', function() {
            const botName = $('#botSearch').val().trim();
            if (!botName) {
                $('#searchResult').html('<div class="alert alert-warning">Please enter a bot name to search</div>');
                return;
            }

            // Show loading state
            $('#searchResult').html('<div class="alert alert-info">Searching for ' + botName + ' in hiscores...</div>');

            // Make AJAX request to search hiscores
            $.ajax({
                url: '/adminRoute/check_hiscores',
                method: 'POST',
                data: { botName: botName },
                success: function(response) {
                    if (response.success && response.combatLevel) {
                        // Set hidden fields with the search result data
                        $('#hiddenSearchedName').val(botName);
                        $('#hiddenNewCombatLevel').val(response.combatLevel);
                        
                        // Show success message with combat level
                        $('#searchResult').html('<div class="alert alert-success">' +
                            'Found ' + botName + ' in hiscores with combat level ' + response.combatLevel +
                            '</div>');
                            
                        // Enable update button if a bot is selected
                        updateSubmitButton();
                    } else {
                        // Show error if bot not found
                        $('#searchResult').html('<div class="alert alert-danger">' +
                            'Could not find ' + botName + ' in hiscores. Please check the name and try again.' +
                            '</div>');
                        // Clear hidden fields
                        $('#hiddenSearchedName').val('');
                        $('#hiddenNewCombatLevel').val('');
                        updateSubmitButton();
                    }
                },
                error: function(xhr, status, error) {
                    let errorMsg = 'Error searching hiscores. Please try again.';
                    try {
                        const response = JSON.parse(xhr.responseText);
                        if (response.error) {
                            errorMsg = response.error;
                        }
                    } catch (e) {
                        console.error('Error parsing error response:', e);
                    }
                    $('#searchResult').html('<div class="alert alert-danger">' + errorMsg + '</div>');
                    // Clear hidden fields on error
                    $('#hiddenSearchedName').val('');
                    $('#hiddenNewCombatLevel').val('');
                    updateSubmitButton();
                }
            });
        });

        // Handle form submission
        $('#updateBotForm').on('submit', function(e) {
            // Client-side validation
            const selectedBot = $('#botSelect').val();
            const searchedName = $('#hiddenSearchedName').val();
            const newCombatLevel = $('#hiddenNewCombatLevel').val();
            
            if (!selectedBot || !searchedName || !newCombatLevel) {
                e.preventDefault();
                alert('Please select a bot and search for a valid hiscores entry first.');
                return false;
            }
            
            // Show loading state on the submit button
            const $btn = $('#updateBotBtn');
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Updating...');
            
            // Form will submit normally after this
        });
        
        // Update submit button state when bot selection changes
        $('#botSelect').on('change', updateSubmitButton);
        
        // Initial update of submit button state
        updateSubmitButton();

        // Handle alias modal
        $('#aliasModal').on('show.bs.modal', function(event) {
            const button = $(event.relatedTarget);
            const botId = button.data('id');
            const botName = button.closest('tr').find('td:first').text().trim();
            const modal = $(this);
            
            // Set bot ID in the form
            modal.find('.modal-body #botId').val(botId);
            
            // Set the alias input value to the bot's name
            // This will be used as the default value for the alias
            modal.find('.modal-body #alias').val(botName);
            
            // Clear any previous validation errors
            $('#alias').removeClass('is-invalid');
            $('.invalid-feedback').remove();
        });

        // Handle update alias form submission
        $('#updateAliasForm').on('submit', function(e) {
            e.preventDefault();
            
            const botId = $('#botId').val();
            const alias = $('#alias').val().trim();
            
            // Basic client-side validation
            if (!alias) {
                showError('Alias cannot be empty');
                return;
            }
            
            // Show loading state
            const $submitBtn = $(this).find('button[type="submit"]');
            const originalBtnText = $submitBtn.html();
            $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Updating...');
            
            // Clear previous errors
            $('#alias').removeClass('is-invalid');
            $('.invalid-feedback').remove();
            
            // Make the API call
            $.ajax({
                url: '/adminRoute/update-alias-and-fetch-combat',
                method: 'POST',
                data: { 
                    botId: botId, 
                    alias: alias 
                },
                success: function(response) {
                    if (response.success) {
                        // Update the table row with the new data
                        const $row = $('tr[data-bot-id="' + botId + '"]');
                        $row.find('td:nth-child(2)').text(response.bot.alias); // Update alias column
                        $row.find('td:nth-child(4)').text(response.bot.combat_lv); // Update combat level column
                        
                        // Update the status badge if needed
                        if (response.bot.combat_lv > 0) {
                            $row.find('.status-badge')
                                .removeClass('bg-warning')
                                .addClass('bg-success')
                                .text('ACTIVE');
                        }
                        
                        // Close the modal
                        $('#aliasModal').modal('hide');
                        
                        // Show success message
                        showSuccess('Bot updated successfully!');
                    } else {
                        showError(response.message || 'Failed to update bot');
                    }
                },
                error: function(xhr) {
                    let errorMessage = 'An error occurred while updating the bot';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    showError(errorMessage);
                },
                complete: function() {
                    // Restore button state
                    $submitBtn.prop('disabled', false).html('Fetch Combat Level');
                }
            });
        });
        
        // Helper function to show error messages
        function showError(message) {
            const $aliasInput = $('#alias');
            $aliasInput.addClass('is-invalid');
            $aliasInput.after('<div class="invalid-feedback">' + message + '</div>');
        }
        
        // Helper function to show success messages
        function showSuccess(message) {
            // You can replace this with a more sophisticated notification system if you have one
            alert(message);
        }

        // Handle delete bot
        $('.delete-bot').on('click', function() {
            if (!confirm('Are you sure you want to delete this bot? This action cannot be undone.')) {
                return;
            }
            
            const botId = $(this).data('id');
            
            $.ajax({
                url: '/adminRoute/delete_bot',
                method: 'POST',
                data: { id: botId },
                success: function(response) {
                    if (response.success) {
                        // Remove the bot row from the table
                        $('tr[data-bot-id="' + botId + '"]').remove();
                    } else {
                        alert('Error deleting bot: ' + (response.message || 'Unknown error'));
                    }
                },
                error: function(xhr) {
                    const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : 'Error deleting bot';
                    alert('Error: ' + errorMessage);
                }
            });
        });
    </script>
    <%- include('../partials/scripts'); %>
</body>
</html>
