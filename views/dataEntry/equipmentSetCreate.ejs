<%- include('../partials/scripts') %>


<!-- Page-specific scripts -->
<script src="/javascripts/equipmentSetManager.js"></script>
<script>
// Initialize tooltips
var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
  return new bootstrap.Tooltip(tooltipTriggerEl);
});

// Add event listeners to equipment slots
document.querySelectorAll('.equipment-slot').forEach(slot => {
    slot.addEventListener('click', function() {
        const slotName = this.getAttribute('data-slot');
        if (slotName) {
            findItem(slotName);
        }
    });
});

// Handle set search
const setSearch = document.getElementById('set-search');
if (setSearch) {
  setSearch.addEventListener('input', function() {
    const searchTerm = this.value.toLowerCase();
    const setItems = document.querySelectorAll('.set-item');
    
    setItems.forEach(item => {
      const setName = item.querySelector('.set-name').textContent.toLowerCase();
      if (setName.includes(searchTerm)) {
        item.style.display = 'flex';
      } else {
        item.style.display = 'none';
      }
    });
  });
}

// Function to open create modal
function openCreateModal() {
  const modal = new bootstrap.Modal(document.getElementById('createSetModal'));
  modal.show();
}

// Function to clear all equipment slots
function clearAllSlots() {
  if (confirm('Are you sure you want to clear all equipment slots?')) {
    const slots = ['head', 'cape', 'neck', 'ammunition', 'torso', 'left_hand', 'right_hand', 'legs', 'hands', 'feet', 'jewelry'];
    slots.forEach(slot => {
      document.getElementById(`${slot}-img`).src = '/images/Bank_filler.png';
      // You might want to clear the associated data as well
    });
  }
}

// Helper function to extract item name from URL
function extractItemNameFromUrl(url) {
    if (!url) return '';
    
    // If it's already just an item name, return as is
    if (!url.includes('://')) {
        return url;
    }
    
    // Extract the filename from URL and remove query parameters
    try {
        const urlObj = new URL(url);
        const pathParts = urlObj.pathname.split('/');
        let filename = pathParts[pathParts.length - 1];
        
        // Remove file extension if present
        const dotIndex = filename.lastIndexOf('.');
        if (dotIndex > 0) {
            filename = filename.substring(0, dotIndex);
        }
        
        return filename;
    } catch (e) {
        console.error('Error parsing URL:', e);
        return url; // Return original if parsing fails
    }
}

// Helper function to format item name (capitalize first letter of first word, keep rest lowercase, and replace spaces with underscores)
function formatItemName(itemName) {
    if (!itemName) return '';
    
    // Convert to lowercase
    const lowerName = itemName.toLowerCase();
    
    // Capitalize first letter of the entire string
    if (lowerName.length === 0) return '';
    
    const firstChar = lowerName.charAt(0).toUpperCase();
    const restOfString = lowerName.slice(1);
    
    // Replace all spaces with underscores in the result
    return (firstChar + restOfString).replace(/ /g, '_');
}

// Helper function to construct full image URL from item name
function getItemImageUrl(itemName) {
    if (!itemName) return '/images/Bank_filler.png';
    
    // If it's already a full URL, return as is (for backward compatibility)
    if (itemName.startsWith('http')) {
        return itemName;
    }
    
    // Format the item name and construct the OSRS Wiki image URL
    const formattedName = formatItemName(itemName);
    return `https://oldschool.runescape.wiki/images/${formattedName}.png`;
}

// Function to handle clicking on an equipment slot
async function findItem(slot) {
    // Show a styled prompt for better UX
    const itemName = prompt(`Enter the name of the item for ${slot.replace('_', ' ')}:`, '');
    
    if (!itemName || !itemName.trim()) {
        showToast('No item name provided', 'warning');
        return;
    }
    
    const slotElement = document.getElementById(`${slot}-img`);
    if (!slotElement) {
        console.error(`Could not find element with ID: ${slot}-img`);
        return;
    }
    
    console.log(`Searching for item: ${itemName} in slot: ${slot}`);
    
    // Show loading state
    slotElement.src = '/images/loading.gif';
    slotElement.style.opacity = '0.7';
    
    try {
        // First, try with the exact name (case-sensitive)
        let formattedItemName = itemName;
        let imageUrl = `https://oldschool.runescape.wiki/images/${formattedItemName}.png`;
        let imageExists = await checkImageExists(imageUrl);
        
        // If that fails, try with formatted name (first letter capitalized, rest lowercase, spaces to underscores)
        if (!imageExists) {
            formattedItemName = formatItemName(itemName);
            imageUrl = `https://oldschool.runescape.wiki/images/${formattedItemName}.png`;
            imageExists = await checkImageExists(imageUrl);
            
            // If still not found, try with all words capitalized (for items like 'Amulet of glory')
            if (!imageExists) {
                const allWordsCapitalized = itemName.toLowerCase()
                    .split(' ')
                    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                    .join('_');
                imageUrl = `https://oldschool.runescape.wiki/images/${allWordsCapitalized}.png`;
                imageExists = await checkImageExists(imageUrl);
                if (imageExists) {
                    formattedItemName = allWordsCapitalized;
                }
            }
        }
        
        if (!imageExists) {
            throw new Error(`Could not find image for "${itemName}". Tried: ${formattedItemName}`);
        }
        
        // Cache the image
        await cacheImage(imageUrl, imageUrl);
        
        // Update the slot with the new item
        slotElement.src = imageUrl;
        slotElement.style.opacity = '1';
        slotElement.setAttribute('data-item-name', formattedItemName);
        slotElement.setAttribute('data-item-url', imageUrl); // Keep for backward compatibility
        
        showToast(`Added ${formattedItemName.replace(/_/g, ' ')} to ${slot.replace('_', ' ')}`, 'success');
        
    } catch (error) {
        console.error('Error finding item:', error);
        slotElement.src = '/images/Bank_filler.png';
        slotElement.style.opacity = '1';
        showToast(error.message || 'Failed to find item', 'error');
    }
}

// Helper function to check if a string is a valid URL
function isValidUrl(string) {
    try {
        new URL(string);
        return true;
    } catch (_) {
        return false;
    }
}

// Function to update an equipment slot with a new item
async function updateEquipmentSlot(slot, itemNameOrUrl) {
    const imgElement = document.getElementById(`${slot}-img`);
    if (!imgElement) return;
    
    try {
        // Show loading state
        imgElement.src = '/images/loading.gif';
        
        // Convert to full URL if it's just an item name
        const imageUrl = itemNameOrUrl.startsWith('http') ? itemNameOrUrl : 
                        `https://oldschool.runescape.wiki/images/${itemNameOrUrl}.png`;
        
        // Check if the image exists
        const imageExists = await checkImageExists(imageUrl);
        
        if (imageExists) {
            // Extract and store just the item name
            const itemName = extractItemNameFromUrl(imageUrl);
            
            // Update the image source
            imgElement.src = imageUrl;
            imgElement.style.opacity = '1';
            imgElement.setAttribute('data-item-name', itemName);
            imgElement.setAttribute('data-item-url', imageUrl); // Keep for backward compatibility
        } else {
            // If image doesn't exist, show a placeholder
            imgElement.src = '/images/Bank_filler.png';
            showToast('Could not load the specified item. Please check the name and try again.', 'error');
        }
    } catch (error) {
        console.error('Error updating equipment slot:', error);
        imgElement.src = '/images/Bank_filler.png';
        alert('An error occurred while updating the equipment slot.');
    }
}

// Function to check if an image exists at the given URL
async function checkImageExists(url) {
    try {
        const response = await fetch(url, { method: 'HEAD' });
        console.log(response);
        return response.ok;
    } catch (error) {
        console.error('Error checking image:', error);
        return false;
    }
}

// Function to create a new equipment set
async function createEquipmentSet() {
    const setName = document.getElementById('set_name').value.trim();
    
    if (!setName) {
        showToast('Please enter a name for the equipment set', 'error');
        return;
    }
    
    // Show loading state
    const saveButton = document.querySelector('#createSetModal .btn-primary');
    const originalButtonText = saveButton.innerHTML;
    saveButton.disabled = true;
    saveButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...';
    
    try {
        // Collect equipment data with just item names and verify images
        const equipmentData = {};
        const slots = ['head', 'cape', 'neck', 'ammunition', 'torso', 'left_hand', 'right_hand', 'legs', 'hands', 'feet', 'jewelry'];
        
        // First, verify all images exist
        for (const slot of slots) {
            const imgElement = document.getElementById(`${slot}-img`);
            let itemName = '';
            
            if (imgElement && imgElement.getAttribute('data-item-name')) {
                itemName = imgElement.getAttribute('data-item-name');
            } else if (imgElement && imgElement.src && !imgElement.src.endsWith('Bank_filler.png')) {
                itemName = extractItemNameFromUrl(imgElement.src);
            }
            
            if (itemName) {
                // Format the item name
                const formattedName = formatItemName(itemName);
                const imageUrl = `https://oldschool.runescape.wiki/images/${formattedName}.png`;
                
                // Verify the image exists
                const imageExists = await checkImageExists(imageUrl);
                if (!imageExists) {
                    throw new Error(`Could not verify image for ${formattedName.replace(/_/g, ' ')}`);
                }
                
                equipmentData[slot] = formattedName;
            } else {
                equipmentData[slot] = '';
            }
        }
        
        // If we get here, all images are valid - proceed with save
        const response = await fetch('/deRoute/createEquipmentSet', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                set_name: setName,
                ...equipmentData
            })
        });
        
        const result = await response.json();
        
        if (!response.ok) {
            throw new Error(result.message || 'Failed to create equipment set');
        }
        
        // Close the modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('createSetModal'));
        if (modal) {
            modal.hide();
        }
        
        // Reset the form
        document.getElementById('set_name').value = '';
        
        // Reload the equipment sets to show the new one
        loadEquipmentSets();
        
        // Show success message
        showToast('Equipment set created successfully!', 'success');
        
    } catch (error) {
        console.error('Error creating equipment set:', error);
        showToast(`Error: ${error.message}`, 'error');
    } finally {
        // Reset button state
        if (saveButton) {
            saveButton.disabled = false;
            saveButton.innerHTML = originalButtonText;
        }
    }
}

// Function to cache an image
async function cacheImage(key, url) {
    try {
        const response = await fetch(url);
        const blob = await response.blob();
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onloadend = () => {
                const base64data = reader.result;
                const cacheItem = {
                    url: base64data,
                    timestamp: new Date().getTime()
                };
                localStorage.setItem(`equipment_${key}`, JSON.stringify(cacheItem));
                resolve();
            };
            reader.onerror = reject;
            reader.readAsDataURL(blob);
        });
    } catch (error) {
        console.error('Error caching image:', error);
        throw error;
    }
}
