<!-- Main Content -->
<!-- Theme Toggle Moved to Navbar -->

<div class="container">
  <div class="row justify-content-center">
    <div class="col-12 mb-4 text-center">
      <h1 class="page-title">Equipment Set Manager</h1>
      <p class="text-muted">Create and manage equipment sets for your bots</p>
    </div>
  </div>

  <div class="row g-4">
    <!-- Equipment Builder Card -->
    <div class="col-lg-6">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Equipment Builder</h5>
          <button class="btn btn-sm btn-outline-primary" onclick="clearAllSlots()">
            <i class="bi bi-trash me-1"></i> Clear All
          </button>
        </div>
        <div class="card-body text-center">
          <div class="equipment-grid mb-4">
            <!-- Row 1 -->
            <div></div>
            <div class="equipment-slot" onclick="findItem('head')" title="Head">
              <img id="head-img" src="/images/Bank_filler.png" alt="Head">
            </div>
            <div></div>
            
            <!-- Row 2 -->
            <div class="equipment-slot" onclick="findItem('cape')" title="Cape">
              <img id="cape-img" src="/images/Bank_filler.png" alt="Cape">
            </div>
            <div class="equipment-slot" onclick="findItem('neck')" title="Neck">
              <img id="neck-img" src="/images/Bank_filler.png" alt="Neck">
            </div>
            <div class="equipment-slot" onclick="findItem('ammunition')" title="Ammunition">
              <img id="ammunition-img" src="/images/Bank_filler.png" alt="Ammunition">
            </div>
            
            <!-- Row 3 -->
            <div class="equipment-slot" onclick="findItem('left_hand')" title="Left Hand">
              <img id="left_hand-img" src="/images/Bank_filler.png" alt="Left Hand">
            </div>
            <div class="equipment-slot" onclick="findItem('torso')" title="Torso">
              <img id="torso-img" src="/images/Bank_filler.png" alt="Torso">
            </div>
            <div class="equipment-slot" onclick="findItem('right_hand')" title="Right Hand">
              <img id="right_hand-img" src="/images/Bank_filler.png" alt="Right Hand">
            </div>
            
            <!-- Row 4 -->
            <div></div>
            <div class="equipment-slot" onclick="findItem('legs')" title="Legs">
              <img id="legs-img" src="/images/Bank_filler.png" alt="Legs">
            </div>
            <div></div>
            
            <!-- Row 5 -->
            <div class="equipment-slot" onclick="findItem('hands')" title="Hands">
              <img id="hands-img" src="/images/Bank_filler.png" alt="Hands">
            </div>
            <div class="equipment-slot" onclick="findItem('feet')" title="Feet">
              <img id="feet-img" src="/images/Bank_filler.png" alt="Feet">
            </div>
            <div class="equipment-slot" onclick="findItem('jewelry')" title="Jewelry">
              <img id="jewelry-img" src="/images/Bank_filler.png" alt="Jewelry">
            </div>
          </div>
          
          <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="bi bi-save me-1"></i> Save Equipment Set
          </button>
        </div>
      </div>
    </div>
    
    <!-- Equipment Sets Card -->
    <div class="col-lg-6">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi-collection me-2"></i>My Equipment Sets</h5>
          <div class="input-group input-group-sm" style="width: 200px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" id="set-search" class="form-control" placeholder="Search sets...">
          </div>
        </div>
        <div class="card-body p-0">
          <div id="equipment-sets-container" style="max-height: 500px; overflow-y: auto;">
            <div id="equipment-sets" class="p-3">
              <!-- Equipment sets will be loaded here -->
              <div class="text-center py-5" id="loading-sets">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading equipment sets...</p>
              </div>
              <div id="no-sets" class="text-center py-5 d-none">
                <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                <p class="mt-2 text-muted">No equipment sets found. Create one to get started!</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
