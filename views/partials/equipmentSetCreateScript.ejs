  <script>
    let currentlyLoadedSet = null; // Keep track of the currently loaded set
    let currentSetId = null; // Track the currently loaded set ID for updates
    const userRole = '<%= user.role %>'; // User role for permission checks

    function deleteEquipmentSet(setId) {
      const setData = {
        _id: setId,
      };
      if (!confirm('Are you sure you want to delete this equipment set?')) {
        return;
      }
      fetch('/adminRoute/deleteEquipmentSet/', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(setData),
      })
      .then(response => {
        if (response.ok) {
          fetchAndDisplayEquipmentSets()
          const successLabel = document.getElementById('success-label');
          successLabel.innerText = 'Equipment set saved successfully!';
          successLabel.style.display = 'block';
          setTimeout(() => {
            successLabel.style.display = 'none';
          }, 3000);
          const createModal = document.getElementById('createModal');
          createModal.style.display = 'none';
        } else {
          return response.json().then(data => {
            throw new Error(data.message || 'Error creating the equipment set');
          });
        }
      })
      .catch(error => {
        alert(error.message);
      });
    }

    function fetchAndDisplayEquipmentSets() {
      const loadingElement = document.getElementById('loading-sets');
      const noSetsElement = document.getElementById('no-sets');
      const equipmentSetsContainer = document.getElementById('equipment-sets');
      equipmentSetsContainer.innerHTML = '';
      loadingElement.classList.remove('d-none');
      noSetsElement.classList.add('d-none');
      fetch('/deRoute/getEquipmentSets')
      .then(response => response.json())
      .then(data => {
        loadingElement.classList.add('d-none');
        if (data.length === 0) {
          noSetsElement.classList.remove('d-none');
          return;
        }
        data.forEach(set => {
          const setItem = document.createElement('div');
          setItem.className = 'equipment-set-item';
          setItem.setAttribute('data-set-id', set._id);
          const setName = document.createElement('div');
          setName.className = 'set-name';
          setName.textContent = set.set_name;
          setName.style.cursor = 'pointer';
          setName.addEventListener('click', function(e) {
            e.stopPropagation();
            const newName = prompt('Enter new set name:', set.set_name);
            if (newName && newName !== set.set_name) {
              updateSetName(set._id, set.set_name, newName, setName);
            }
          });
          const setItems = document.createElement('div');
          setItems.className = 'set-items';
          ['head', 'cape', 'neck', 'ammunition', 'torso', 'left_hand', 'right_hand', 'legs', 'hands', 'feet', 'jewelry'].forEach(slot => {
            if (set[slot] && set[slot].includes('oldschool.runescape.wiki')) {
              const itemIcon = document.createElement('img');
              itemIcon.src = set[slot];
              itemIcon.className = 'item-icon';
              itemIcon.alt = slot;
              itemIcon.title = slot.replace('_', ' ');
              setItems.appendChild(itemIcon);
            }
          });
          const setActions = document.createElement('div');
          setActions.className = 'set-actions';
          const loadButton = document.createElement('button');
          loadButton.className = 'btn btn-sm btn-outline-primary me-1';
          loadButton.innerHTML = '<i class="bi bi-box-arrow-in-down"></i>';
          loadButton.title = 'Load Set';
          loadButton.onclick = (e) => {
            e.stopPropagation();
            loadEquipmentSet(set);
          };
          const updateButton = document.createElement('button');
          updateButton.className = 'btn btn-sm btn-outline-secondary me-1';
          updateButton.innerHTML = '<i class="bi bi-arrow-clockwise"></i>';
          updateButton.title = 'Update Set';
          updateButton.onclick = (e) => {
            e.stopPropagation();
            updateEquipmentSet(set._id);
          };
          if (userRole === 'Admin') {
            const deleteButton = document.createElement('button');
            deleteButton.className = 'btn btn-sm btn-outline-danger';
            deleteButton.innerHTML = '<i class="bi bi-trash"></i>';
            deleteButton.title = 'Delete Set';
            deleteButton.onclick = (e) => {
              e.stopPropagation();
              deleteEquipmentSet(set._id);
            };
            setActions.appendChild(deleteButton);
          }
          setItem.appendChild(setName);
          setItem.appendChild(setItems);
          setItem.appendChild(loadButton);
          setItem.appendChild(updateButton);
          setItem.appendChild(setActions);
          setItem.addEventListener('click', () => loadEquipmentSet(set));
          equipmentSetsContainer.appendChild(setItem);
        });
        updateSetSelect(data);
      })
      .catch(error => {
        console.error('Error fetching equipment sets:', error);
        loadingElement.classList.add('d-none');
        noSetsElement.classList.remove('d-none');
        noSetsElement.innerHTML = '<i class="bi bi-exclamation-triangle text-danger"></i> Error loading equipment sets';
      });
    }

    function updateSetName(setId, oldName, newName, nameElement) {
      fetch('/adminRoute/updateEquipmentSetName', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ _id: setId, set_name: newName, previous_set_name: oldName })
      })
      .then(response => {
        if (response.ok) {
          nameElement.textContent = newName;
          showAlert('Set name updated successfully!', 'success');
        } else {
          throw new Error('Failed to update set name');
        }
      })
      .catch(error => {
        console.error('Error updating set name:', error);
        showAlert('Error updating set name', 'danger');
      });
    }

    function updateSetSelect(sets) {
      const setSelect = document.getElementById('set-select');
      if (!setSelect) return;
      while (setSelect.options.length > 1) {
        setSelect.remove(1);
      }
      sets.forEach(set => {
        const option = document.createElement('option');
        option.value = set._id;
        option.textContent = set.set_name;
        setSelect.appendChild(option);
      });
      setSelect.disabled = sets.length === 0;
      document.getElementById('apply-button').disabled = sets.length === 0 || !document.getElementById('bot-select').value;
    }

    function updateImage(slot, setId) {
      const itemName = prompt(`Enter the name of the ${slot}:`);
      if (!itemName) {
        document.querySelector(`img[src="${slot}"]`).src = '';
      }
      const imgUrl = `https://oldschool.runescape.wiki/images/${itemName}.png?0a33f`;
      fetch(imgUrl)
      .then(response => {
        if (response.ok) {
          document.querySelector(`img[src="${slot}"]`).src = imgUrl;
        } else {
          alert('Image not found');
        }
      })
      .catch(error => {
        alert('Error fetching the image');
      });
    }

    function loadEquipmentSet(set) {
      currentSetId = set._id;
      if (currentlyLoadedSet) {
        currentlyLoadedSet.classList.remove('active');
      }
      const setElement = document.querySelector(`[data-set-id="${set._id}"]`);
      if (setElement) {
        setElement.classList.add('active');
        currentlyLoadedSet = setElement;
      }
      const setSelect = document.getElementById('set-select');
      if (setSelect) {
        setSelect.value = set._id;
      }
      ['head', 'cape', 'neck', 'ammunition', 'torso', 'left_hand', 'right_hand', 'legs', 'hands', 'feet', 'jewelry'].forEach(slot => {
        const imgElement = document.getElementById(`${slot}-img`);
        if (imgElement) {
          imgElement.src = set[slot] || '/images/Bank_filler.png';
          imgElement.dataset.originalSrc = set[slot] || '';
          if (imgElement.src.includes('wiki')) {
            imgElement.style.filter = 'none';
            imgElement.style.border = '';
          } else {
            imgElement.src = "/images/Bank_filler.png"
          }
        }
      });
    }

    function updateEquipmentSet(setId) {
      if (!setId) {
        showAlert('No set selected to update', 'warning');
        return;
      }
      const setData = {
        _id: setId,
        head: document.getElementById('head-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('head-img').src : '',
        cape: document.getElementById('cape-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('cape-img').src : '',
        neck: document.getElementById('neck-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('neck-img').src : '',
        ammunition: document.getElementById('ammunition-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('ammunition-img').src : '',
        left_hand: document.getElementById('left_hand-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('left_hand-img').src : '',
        torso: document.getElementById('torso-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('torso-img').src : '',
        right_hand: document.getElementById('right_hand-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('right_hand-img').src : '',
        legs: document.getElementById('legs-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('legs-img').src : '',
        hands: document.getElementById('hands-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('hands-img').src : '',
        feet: document.getElementById('feet-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('feet-img').src : '',
        jewelry: document.getElementById('jewelry-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('jewelry-img').src : '',
      };
      fetch('/deRoute/updateEquipmentSet', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(setData),
      })
      .then(response => {
        if (response.ok) {
          fetchAndDisplayEquipmentSets()
        } else {
          alert('Error updating equipment set');
        }
      })
      .catch(error => {
        alert('Error updating the equipment set');
      });
    }

    function findItem(slot) {
      const itemName = prompt(`Enter the name of the ${slot}:`);
      if (!itemName) {
        document.getElementById(`${slot}-img`).src = '/images/Bank_filler.png'
        return
      }
      const isAlphanumeric = /^[a-zA-Z0-9()' -]+$/.test(itemName);
      if (isAlphanumeric) {
        const formattedItemName = itemName
          .trim()
          .toLowerCase()
          .replace(/ /g, "_")
          .replace(/^(.)/, (match) => match.toUpperCase());
        const imgUrl = `https://oldschool.runescape.wiki/images/${formattedItemName}.png?0a33f`;
        fetch(imgUrl)
        .then(response => {
          if (response.ok) {
            document.getElementById(`${slot}-img`).src = imgUrl;
            const imgElement = document.getElementById(`${slot}-img`);
            if (imgElement.src !== '') {
              imgElement.style.filter = 'none';
              imgElement.style.border = '';
            } else {
              imgElement.style.filter = 'brightness(0) invert(1)';
              imgElement.style.border = '2px solid white';
            }
          } else {
            alert('Image not found');
          }
        })
        .catch(error => {
          alert('Error fetching the image');
        });
      } else {
        console.error("The item name must be alphanumeric.");
      }
    }

    function openCreateModal() {
      document.getElementById('createModal').style.display = 'block';
    }

    function createEquipmentSet() {
      const setName = document.getElementById('set_name').value.trim();
      if (!setName) {
        showAlert('Please enter a name for the equipment set', 'warning');
        return;
      }
      let hasItems = false;
      const slots = ['head', 'cape', 'neck', 'ammunition', 'torso', 'left_hand', 'right_hand', 'legs', 'hands', 'feet', 'jewelry'];
      for (const slot of slots) {
        const img = document.getElementById(`${slot}-img`);
        if (img && img.src.includes('oldschool.runescape.wiki')) {
          hasItems = true;
          break;
        }
      }
      if (!hasItems) {
        showAlert('Please add at least one item to the set', 'warning');
        return;
      }
      const setData = {
        set_name: setName,
        head: document.getElementById('head-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('head-img').src : '',
        cape: document.getElementById('cape-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('cape-img').src : '',
        neck: document.getElementById('neck-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('neck-img').src : '',
        ammunition: document.getElementById('ammunition-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('ammunition-img').src : '',
        left_hand: document.getElementById('left_hand-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('left_hand-img').src : '',
        torso: document.getElementById('torso-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('torso-img').src : '',
        right_hand: document.getElementById('right_hand-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('right_hand-img').src : '',
        legs: document.getElementById('legs-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('legs-img').src : '',
        hands: document.getElementById('hands-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('hands-img').src : '',
        feet: document.getElementById('feet-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('feet-img').src : '',
        jewelry: document.getElementById('jewelry-img').src.includes("https://oldschool.runescape.wiki") ? document.getElementById('jewelry-img').src : '',
      };
      fetch('/deRoute/createEquipmentSet', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(setData),
      })
      .then(response => {
        if (response.ok) {
          fetchAndDisplayEquipmentSets()
          const successLabel = document.getElementById('success-label');
          successLabel.innerText = 'Equipment set saved successfully!';
          successLabel.style.display = 'block';
          setTimeout(() => {
            successLabel.style.display = 'none';
          }, 3000);
          const createModal = document.getElementById('createModal');
          createModal.style.display = 'none';
        } else {
          return response.json().then(data => {
            throw new Error(data.message || 'Error creating the equipment set');
          });
        }
      })
      .catch(error => {
        alert(error.message);
      });
    }

    function fetchLatestBots() {
      fetch('/qcRoute/latest-bots')
      .then(response => response.json())
      .then(bots => {
        const botSelect = document.getElementById('bot-select');
        botSelect.innerHTML = '<option value="" disabled selected>Select a bot</option>';
        if (Array.isArray(bots) && bots.length > 0) {
          bots.forEach(bot => {
            const option = document.createElement('option');
            option.value = bot._id;
            option.textContent = bot.bot_name;
            botSelect.appendChild(option);
          });
        } else {
          console.error('No bots available or invalid data format.');
        }
      })
      .catch(error => {
        console.error('Error fetching latest bots:', error);
      });
    }

    document.getElementById('apply-button').addEventListener('click', async function() {
      const botSelect = document.getElementById('bot-select');
      const selectedBotId = botSelect.value;
      if (!selectedBotId) {
        alert('Please select a bot.');
        return;
      }
      const equipmentSetName = currentlyLoadedSet ? currentlyLoadedSet.querySelector('label').innerText : null;
      if (!equipmentSetName) {
        alert('No equipment set is currently loaded.');
        return;
      }
      try {
        const response = await fetch('/qcRoute/botUpdateEquipmentSetName', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            botId: selectedBotId,
            equipmentSetName: equipmentSetName
          })
        });
        if (!response.ok) {
          console.error('Server responded with an error:', response.statusText);
          return;
        }
        const successMessage = document.getElementById('apply-success-message');
        successMessage.style.display = 'block';
        setTimeout(() => {
          successMessage.style.display = 'none';
        }, 3000);
      } catch (error) {
        console.error('Error updating equipment set:', error);
      }
    });

    document.addEventListener('DOMContentLoaded', function() {
      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });
      fetchAndDisplayEquipmentSets();
      fetchBots();
      const botSelect = document.getElementById('bot-select');
      if (botSelect) {
        botSelect.addEventListener('change', function() {
          const setSelect = document.getElementById('set-select');
          document.getElementById('apply-button').disabled = !this.value || !setSelect.value;
        });
      }
      const setSelect = document.getElementById('set-select');
      if (setSelect) {
        setSelect.addEventListener('change', function() {
          const botSelect = document.getElementById('bot-select');
          document.getElementById('apply-button').disabled = !this.value || !botSelect.value;
        });
      }
      const setSearch = document.getElementById('set-search');
      if (setSearch) {
        setSearch.addEventListener('input', function() {
          const searchTerm = this.value.toLowerCase();
          const setItems = document.querySelectorAll('.equipment-set-item');
          setItems.forEach(item => {
            const setName = item.querySelector('.set-name')?.textContent.toLowerCase() || '';
            if (setName.includes(searchTerm)) {
              item.style.display = 'flex';
            } else {
              item.style.display = 'none';
            }
          });
        });
      }
    });

    function showAlert(message, type = 'info') {
      const alertDiv = document.createElement('div');
      alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
      alertDiv.role = 'alert';
      alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      `;
      const container = document.querySelector('.container');
      if (container) {
        container.insertBefore(alertDiv, container.firstChild);
        setTimeout(() => {
          const alert = bootstrap.Alert.getOrCreateInstance(alertDiv);
          if (alert) alert.close();
        }, 5000);
      }
    }

    function fetchBots() {
      fetch('/deRoute/getBots')
      .then(response => response.json())
      .then(bots => {
        const botSelect = document.getElementById('bot-select');
        if (!botSelect) return;
        while (botSelect.options.length > 1) {
          botSelect.remove(1);
        }
        bots.forEach(bot => {
          const option = document.createElement('option');
          option.value = bot._id;
          option.textContent = bot.bot_name || `Bot ${bot._id}`;
          botSelect.appendChild(option);
        });
      })
      .catch(error => {
        console.error('Error fetching bots:', error);
        showAlert('Error loading bots', 'danger');
      });
    }
    
    // Initialize the application
    document.addEventListener('DOMContentLoaded', function() {
      fetchLatestBots();
      fetchAndDisplayEquipmentSets();
    });
</script>