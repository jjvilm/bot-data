<!-- Include DataTables and jQuery scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

<!-- script for updating the page with new data -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    let dataTableInstance;
    const rowColors = {}; // Object to store row colors by bot name

    // Initialize DataTable on page load
    dataTableInstance = $('#week-kills-table').DataTable({
        order: [[4, 'desc']], // Sort by the 5th column (Kill Date) in descending order
    });

    const tableBody = document.querySelector('#week-kills-table tbody');

    // Function to set row colors
    function initializeRowColors() {
        const rows = tableBody.querySelectorAll('tr');

        rows.forEach((row) => {
            const botName = row.querySelector('td:nth-child(2) a')?.textContent.trim();
            const timeAgoColumnText = parseInt(row.querySelector('td:nth-child(6)')?.textContent.trim().slice(8, 11));
            const timeAgoMinColumnText = row.querySelector('td:nth-child(6)')?.textContent.trim().slice(10, 14);
            let initialColor = 'red'; // Default color

            if (botName === undefined) {
                return; 
            }

            try {
                if (timeAgoColumnText < 10 && timeAgoMinColumnText.includes("min")) {
                    initialColor = 'green';
                } 

            } catch (error) {
                console.error(`Error parsing date for ${botName}:`, error.message);
            }

            // Apply color to row
            initialColor = rowColors[botName] || initialColor;
            row.style.backgroundColor = initialColor;

            // Add click event listener to all cells
            row.querySelectorAll('td').forEach(cell => {
                cell.addEventListener('click', function () {
                    const newColor = row.style.backgroundColor === 'green' ? 'red' : 'green';
                    row.style.backgroundColor = newColor;

                    if (botName) {
                        rowColors[botName] = newColor;
                    }
                });
            });
        });
    }








    // Fetch the latest bot data
    async function fetchLatestBots() {
        try {
            const response = await fetch('/qcRoute/latest-bots');
            const bots = await response.json();

            // Clear the existing table rows using DataTable API
            dataTableInstance.clear();
            // DATA THAT GOES ON
            // Prepare new rows from fetched bot data
            const newRows = bots.map(bot => [
                `<a href="/qcRoute/player-latest-bots?hunter_name=${bot.most_recent_kill.hunter_name}" style="color: black;">${bot.most_recent_kill.hunter_name}</a>`,
                `<a href="/deRoute/botKills?id=${bot._id}" style="color: black;">${bot.bot_name} (${bot.combat_lv})</a>
                    <div id="equipment-images-${bot._id}"></div>`,
                `<span style="font-size: larger;">${bot.most_recent_kill.world_number}</span>`,
                // bot.comments === 'BANNED' ? bot.comments : `${bot.comments}
                // <button type="button" class="btn btn-info update-bot-btn" data-toggle="modal" data-target="#updateModal" 
                //     data-id="${bot._id}"
                //     data-botname="${bot.bot_name}"
                //     data-combatlv="${bot.combat_lv}"
                //     data-comments="${bot.comments}">
                //     Post
                // </button>`,
                // new Date(bot.most_recent_kill.kill_date).toISOString().split('T')[0], // Format Kill Date
                new Date(bot.most_recent_kill.kill_date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + `<br>`+ `${calculateMinutesSinceKill(bot.most_recent_kill.kill_date)} ago`,
                formatNumber(bot.most_recent_kill.loot_amount),
                
            ]);

            // Add new rows to DataTable
            dataTableInstance.rows.add(newRows).draw();

            // Reattach event listeners for modal buttons
            document.querySelectorAll('.update-bot-btn').forEach(button => {
                button.addEventListener('click', function () {
                    populateModal(this);
                });
            });
            
            // Displays the images for equipment sets
            bots.forEach(bot => {
                fetchEquipmentSet(bot._id, bot.equipment_set_name);
            });
            
            // Reinitialize row colors after table update
            initializeRowColors();
        } catch (error) {
            console.error('Error fetching latest bots:', error);
        }

    // Apply filter after the table loads
    filterBotsByCombatLevel(parseInt(localStorage.getItem('combatLevel')), parseInt(localStorage.getItem('combatRange')));
    }

   
    async function fetchEquipmentSet(botId, setName) {
        if (!setName) {
            // console.warn(`No set name provided for bot ID: ${botId}`);
            return;
        }
        try {
            const response = await fetch(`/deRoute/getEquipmentSetByName?set_name=${setName}`);
            const equipmentSet = await response.json();

            if (!response.ok) {
                console.error("bad response");
                return;
            }

            // Only proceed if we received valid equipment set data
            if (equipmentSet && equipmentSet.set_name) {
                const equipmentImagesContainer = document.getElementById(`equipment-images-${botId}`);

                // Check if the container exists in the DOM
                if (!equipmentImagesContainer) {
                    // console.error(`Could not find container for bot ID: ${botId}`);
                    return;
                }

                // Add each equipment image if it exists
                const equipmentPieces = [
                    { key: 'head', label: 'Head' },
                    { key: 'cape', label: 'Cape' },
                    { key: 'neck', label: 'Neck' },
                    { key: 'ammunition', label: 'Ammunition' },
                    { key: 'left_hand', label: 'Left Hand' },
                    { key: 'torso', label: 'Torso' },
                    { key: 'right_hand', label: 'Right Hand' },
                    { key: 'legs', label: 'Legs' },
                    { key: 'hands', label: 'Hands' },
                    { key: 'feet', label: 'Feet' },
                    { key: 'jewelry', label: 'Jewelry' }
                ];

                equipmentPieces.forEach(piece => {
                    const imageUrl = equipmentSet[piece.key];
                    if (imageUrl) {
                        const img = document.createElement('img');
                        img.src = imageUrl;
                        img.alt = piece.label;
                        img.style = "width: 30px; height: 30px; margin-right: 5px;";
                        equipmentImagesContainer.appendChild(img);
                    }
                });
            } 

        } catch (error) {
            console.error('Error fetching equipment set:', error);
        }
    };

    // Fetch the latest bots every 1 minute
    setInterval(fetchLatestBots, 60000);

    // INITIAL fetch
    fetchLatestBots();

    // Initialize row colors on page load
    initializeRowColors();

    

});

function formatNumber(number) {
    if (number >= 1000000) {
        return (number / 1000).toFixed(0) + 'K'; // For numbers 1,000,000 and above
    } else if (number >= 1000) {
        return (number / 1000).toFixed(0) + 'K'; // For numbers between 1,000 and 999,999
    } else {
        return number.toString(); // For numbers below 1,000
    }
};

function calculateMinutesSinceKill(killDate) {
    const killTime = new Date(killDate);
    const now = new Date();
    const diffInMs = now - killTime;
    const elapsedMins = Math.floor(diffInMs / 60000);

    if (elapsedMins <= 60) {
        return `${elapsedMins} min`;
    } else if (elapsedMins <= 1440) {
        const elapsedHours = (elapsedMins / 60).toFixed(1);
        return `${elapsedHours} hr`;
        
    } else {
        const elapsedHours = (elapsedMins / 60 / 24).toFixed(1);
        return `${elapsedHours} day`;
    } 
}

 // Function to populate the modal with data from the clicked button
function populateModal(button) {
    const botId = button.getAttribute('data-id');
    const botName = button.getAttribute('data-botname');
    const combatLv = button.getAttribute('data-combatlv');
    const comments = button.getAttribute('data-comments');

    const idInput = document.querySelector('#updateModal input[name="id"]');
    const combatLvInput = document.querySelector('#updateModal input[name="combat_lv"]');
    const commentsInput = document.querySelector('#updateModal input[name="comments"]');
    const modalTitle = document.querySelector('#updateModalLabel strong');

    if (idInput && combatLvInput && commentsInput && modalTitle) {
        idInput.value = botId;
        combatLvInput.value = combatLv;
        commentsInput.value = comments;
        modalTitle.textContent = botName;
    } else {
        console.error('Modal elements not found.');
    }
}

function convertToUserLocalTime(isoDateString) {
    // Convert the ISO date string to a Date object
    const dateObject = new Date(isoDateString);
    
    // Get the user's local time as a string
    const localTime = dateObject.toLocaleString();

    return localTime;
}

document.addEventListener('DOMContentLoaded', function () {
    // Fetch stored combat level and range from localStorage
    let storedCombatLevel = localStorage.getItem('combatLevel');
    let storedCombatRange = localStorage.getItem('combatRange');

     // If combatLevel is not stored, alert the user and ask for input
     if (!storedCombatLevel) {
        alert("Combat level is not set. Please enter a combat level.");
        // Optionally, you can set a default value
        storedCombatLevel = 3; // Set default if needed
        localStorage.setItem('combatLevel', storedCombatLevel); // Store it for future use
    }

    // Set the stored or default values in the input fields
    document.getElementById('combatLevelInput').value = storedCombatLevel;

    // If combatRange is not stored, set a default value of 10
    if (!storedCombatRange) {
        storedCombatRange = 10; // Set default value
        localStorage.setItem('combatRange', storedCombatRange); // Store it for future use
    }

    // Set the stored or default values in the input fields
    document.getElementById('combatRangeInput').value = storedCombatRange;

    // Event listener for the filter button
    document.getElementById('filterBotsBtn').addEventListener('click', function () {
        const combatLevel = parseInt(document.getElementById('combatLevelInput').value, 10);
        const combatRange = parseInt(document.getElementById('combatRangeInput').value, 10);

        // Validate the combat level and range inputs
        if (isNaN(combatLevel) || combatLevel < 3 || combatLevel > 126) {
            alert("Please enter a valid Combat Level between 3 and 126.");
            return;
        }

        if (isNaN(combatRange) || combatRange < 1 || combatRange > 55) {
            alert("Please enter a valid Combat Range between 10 and 15.");
            return;
        }

        // Store these values in localStorage
        localStorage.setItem('combatLevel', combatLevel);
        localStorage.setItem('combatRange', combatRange);

        // Filter the bots based on the combat level and range
        filterBotsByCombatLevel(combatLevel, combatRange);
    });

    // Function to filter bots based on combat level and range
    function filterBotsByCombatLevel(combatLevel, combatRange) {
        const rows = document.querySelectorAll('#week-kills-table tbody tr');
        rows.forEach(row => {
            // Assuming the combat level is stored in parentheses in the second column
            const botCombatLevelText = row.querySelector('td:nth-child(2)')?.textContent.split('(')[1]?.split(')')[0];
            const botCombatLevel = parseInt(botCombatLevelText, 10);

            // If botCombatLevel is within the range, display the row, otherwise hide it
            if (botCombatLevel >= (combatLevel - combatRange) && botCombatLevel <= (combatLevel + combatRange)) {
                row.style.display = ''; // Show row
            } else {
                row.style.display = 'none'; // Hide row
            }
        });
    }

    // If filter criteria are already in localStorage, apply the filter on page load
    if (storedCombatLevel && storedCombatRange) {
        filterBotsByCombatLevel(parseInt(storedCombatLevel), parseInt(storedCombatRange));
    }
});

// Function to filter bots based on combat level and range
function filterBotsByCombatLevel(combatLevel, combatRange) {
    const rows = document.querySelectorAll('#week-kills-table tbody tr');
    rows.forEach(row => {
        // Assuming the combat level is stored in parentheses in the second column
        const botCombatLevelText = row.querySelector('td:nth-child(2)')?.textContent.split('(')[1]?.split(')')[0];
        const botCombatLevel = parseInt(botCombatLevelText, 10);

        // If botCombatLevel is within the range, display the row, otherwise hide it
        if (botCombatLevel >= (combatLevel - combatRange) && botCombatLevel <= (combatLevel + combatRange) || botCombatLevel === 0) {
            row.style.display = ''; // Show row
        } else {
            row.style.display = 'none'; // Hide row
        }
    });
}

// Function to get and validate combat level
function getCombatLevel() {
        // Check if combat level is already saved in localStorage
        let storedCombatLevel = localStorage.getItem('combatLevel');

        // If it's not saved, prompt the user for it
        if (!storedCombatLevel) {
            // Keep prompting until the user enters a valid combat level
            while (true) {
                storedCombatLevel = prompt("Please enter your combat level (between 3 and 126):");

                // Validate the input: must be a positive integer between 3 and 126
                if (storedCombatLevel !== null) {
                    storedCombatLevel = parseInt(storedCombatLevel);

                    // Check if the combat level is a number and within the valid range
                    if (!isNaN(storedCombatLevel) && storedCombatLevel >= 3 && storedCombatLevel <= 126) {
                        // Save the valid combat level to localStorage
                        localStorage.setItem('combatLevel', storedCombatLevel);
                        break;  // Exit the loop once a valid value is entered
                    } else {
                        alert("Please enter a valid combat level between 3 and 126.");
                    }
                } else {
                    // If the user cancels the prompt, break out of the loop
                    break;
                }
            }
        }
    }

// Call the function to get the combat level if it's not stored
getCombatLevel();

</script>
