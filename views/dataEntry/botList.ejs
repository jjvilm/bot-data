<!doctype html>
<html lang="en">
<%- include('../partials/headfile'); %>
<link rel="stylesheet" href="/stylesheets/botList.css" />
  <body>
    <%- include('../partials/navbar'); %>
<div class="container">
  <!-- <a href="/deRoute/botCreate" class="btn btn-primary">Create</a> -->
  <a href="/qcRoute" class="btn btn-primary">Recent Kills</a>
  <a href="/deRoute/topWorlds" class="btn btn-primary">World Kills</a>
  <a href="/qcRoute/commonlyVisitedWorlds" class="btn btn-primary">Top Worlds</a>
  <!-- <a href="/deRoute/exportCsv" class="btn btn-primary">Export CSV</a> -->
  <!-- <a href="/deRoute/exportExcel" class="btn btn-primary">Export Excel</a> -->
  <h1>Bot Database</h1>

  <!-- Search form -->
  <div class="input-group mb-3">
    <input type="text" id="searchInput" class="form-control" placeholder="Search for a bot" aria-label="Search for a bot" aria-describedby="searchButton">
    <div class="input-group-append">
      <button class="btn btn-outline-secondary" type="button" id="searchButton">Search</button>
    </div>
  </div>

  <!-- Table for displaying bots -->
  <div class="table-responsive">
    <table class="table table-hover table-dark" id="botTable">
      <thead class="thead-light">
        <tr>
          <th>Bot Name</th>
          <th>Combat Level</th>
          <th>Comments</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% for (var i = 0; i < bots.length; i++) { %>
          <tr>
            <td><%= bots[i].bot_name %></td>
            <td><%= bots[i].combat_lv %></td>
            <td><%= bots[i].comments %></td>
            <td>
              <a href="/deRoute/botKills?id=<%= bots[i]._id %>" class="btn btn-primary">Kills</a>
              <a href="/deRoute/botUpdate?id=<%= bots[i]._id %>" class="btn btn-primary">Edit</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Navigation buttons -->
  <div class="d-flex justify-content-center">
    <button class="btn btn-primary" id="backButton">Back</button>
    <button class="btn btn-primary" id="nextButton">Next</button>
  </div>
</div>

    <%- include('../partials/scripts'); %>
      <script type="text/javascript">
        document.getElementById('searchButton').addEventListener('click', function() {
          const searchQuery = document.getElementById('searchInput').value;
          if (searchQuery) {
            fetch(`/deRoute/getBotNameHunts?name=${searchQuery}`)
              .then(response => {
                if (response.status === 204) {
                  document.getElementById('searchInput').value = '';
                } else {
                  window.location.href = `/deRoute/getBotNameHunts?name=${searchQuery}`;
                }
              })
              .catch(error => console.error('Error:', error));
          }
        });

        document.getElementById('nextButton').addEventListener('click', function() {
          window.location.href = '/deRoute/botList?next=true';
        });

        document.getElementById('backButton').addEventListener('click', function() {
          window.location.href = '/deRoute/botList?next=false';
        });
      </script>
      
  </body>
</html>