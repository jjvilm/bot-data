<!DOCTYPE html>
<html lang="en">
<%- include('../partials/headfile'); %>
<link rel="stylesheet" href="/stylesheets/botList.css" />
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bot Hunting Data</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="/stylesheets/weekKills.css" rel="stylesheet">
</head>

<body>
    <%- include('../partials/navbar'); %>

    <div class="container py-4">
        <div class="d-flex justify-content-center">
            <div class="btn-group" role="group" aria-label="Navigation Controls">
                <a href="/deRoute/botList" class="btn btn-success">All Bots</a>
                <a href="/deRoute/topWorlds" class="btn btn-secondary">World Kills</a>
                <a href="/qcRoute/commonlyVisitedWorlds" class="btn btn-danger">Top Worlds</a>
                <a href="/deRoute/EquipmentSets" class="btn btn-dark">Equipments</a>
                <button id="toggleFilterBtn" class="btn btn-info">Filter</button>
            </div>
        </div>

    <!-- Move input fields to the bottom left corner below the navbar -->
    <div class="filter-container" id="filterContainer">
        <div class="input-group mr-2">
            <div class="input-group-prepend">
                <span class="input-group-text" id="combatLevelLabel" style="background-color: #343a40; color: white;">Combat Level</span>
            </div>
            <input type="number" id="combatLevelInput" class="form-control" placeholder="Enter" min="3" max="126" aria-label="Combat Level" aria-describedby="combatLevelLabel">
        </div>
        <div class="input-group mr-2">
            <div class="input-group-prepend">
                <span class="input-group-text" id="combatRangeLabel" style="background-color: #343a40; color: white;">Range (±)</span>
            </div>
            <input type="number" id="combatRangeInput" class="form-control" placeholder="Enter" min="1" max="55" value="10" aria-label="Combat Range" aria-describedby="combatRangeLabel">
        </div>
        <button id="filterBotsBtn" class="btn btn-primary btn-sm">Filter Bots</button>
    </div>

    <div class="container">
        <h4 style="text-align: center;">Hunted Bots</h4>

        <div class="table-container">
            <div class="table-responsive">
                <table class="table table-hover" id="week-kills-table">
                    <thead>
                        <tr>
                            <th scope="col">Bot</th>
                            <th scope="col">World</th>
                            <th scope="col">Time</th>
                            <th scope="col">Loot</th>
                        </tr>
                    </thead>
                <tbody id="botTableBody">
                    <!-- Placeholder for no bots message -->
                </tbody>
            </table>
            <!-- Container for no bots message -->
            <div id="noBotsMessageContainer" style="display: none; text-align: center; font-size: 1.5rem; margin-top: 20px;">
                No Recent Bot Hunts
            </div>
            <!-- Modal -->
            <div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="updateModalLabel">Updating: <strong></strong></h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form method="post" action="/qcRoute/botUpdate">
                                <input type="hidden" name="id" />
                                <div class="form-group">
                                    <label for="combat_lv">Combat Level:</label>
                                    <input type="number" class="form-control" name="combat_lv" min="0" max="126" id="combat_lv" placeholder="Enter Combat Level" required maxLength="3">
                                    <span id="combatLevelError" style="color:red;"></span>
                                </div>
                                <div class="form-group">
                                    <label for="comments">Comments:</label>
                                    <input type="text" class="form-control" name="comments" id="comments" placeholder="Enter Any Comments" maxLength="80">
                                </div>
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <script src="/javascripts/weekKills.js"></script>
        </div>
        <!-- Refresh button -->
        <div id="refreshButtonContainer" style="text-align: center; margin-top: 20px;">
            <button id="refreshPageBtn" class="btn btn-success">Refresh</button>
            <span id="connectionStatus" style="margin-left: 10px; font-weight: bold; color: #ff9800;">Connecting...</span>
        </div>
    </div>
</body>
</html>
